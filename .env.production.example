# Runtime configuration for production (~/na-3d-prod/tracking-task/.env).
#
# CI / deploy.sh NEVER overwrite this file. Create it once on the production
# machine (you may start from an empty file — defaults below are fine).
#
# TASK_IMAGE is exported by deploy.sh on every deploy — do not set it here
# unless you are debugging a manual compose run.

# Host port published to the container's internal :3000 (Traefik uses the
# proxy network and does not need this; deploy.sh health-checks via localhost).
TASK_PORT=3100

# Container timezone (log / SQLite timestamps).
TZ=Asia/Ho_Chi_Minh

# Site access password (login page at /login).
ACCESS_PASSWORD=Derichs2026

# Set true when Traefik/Cloudflare terminates HTTPS in front of the app
# and you want the auth cookie marked Secure.
COOKIE_SECURE=false

# Optional: override how long `docker compose up --wait` waits for healthy (seconds).
# HEALTH_WAIT_TIMEOUT=180
